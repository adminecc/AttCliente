{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metro-malaga.example/schemas/att-cliente-solicitud.schema.json",
  "title": "Metro Malaga - Solicitud de Atencion al Cliente",
  "description": "Contrato JSON para POST /api/solicitudes/crear. Los campos funcionales usan nombres internos de SharePoint (field_internal_name_for_create).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "tipoFormulario",
    "consentimiento"
  ],
  "properties": {
    "tipoFormulario": {
      "type": "string",
      "enum": [
        "reclamaciones",
        "consultas",
        "sugerencias",
        "agradecimientos",
        "objetos",
        "tarjetas"
      ]
    },
    "consentimiento": {
      "type": "boolean",
      "const": true
    },
    "confirmEmail": {
      "type": "string",
      "format": "email"
    },
    "Nombre": {
      "type": "string",
      "maxLength": 255
    },
    "Apellidos": {
      "type": "string",
      "maxLength": 255
    },
    "TipoDeDocumento": {
      "type": "string",
      "enum": [
        "NIF",
        "NIE",
        "PAS"
      ]
    },
    "NumeroDeDocumento": {
      "type": "string",
      "maxLength": 255
    },
    "CorreoElectronico": {
      "type": "string",
      "format": "email"
    },
    "Telefono": {
      "type": "string"
    },
    "Nacionalidad": {
      "type": "string"
    },
    "Direccion": {
      "type": "string",
      "maxLength": 255
    },
    "Numero": {
      "type": "string",
      "maxLength": 255
    },
    "Escalera": {
      "type": "string",
      "maxLength": 255
    },
    "Piso": {
      "type": "string",
      "maxLength": 255
    },
    "Puerta": {
      "type": "string",
      "maxLength": 255
    },
    "CP": {
      "type": "string",
      "maxLength": 255
    },
    "Localidad": {
      "type": "string",
      "maxLength": 255
    },
    "Provincia": {
      "type": "string",
      "maxLength": 255
    },
    "TipoDeTitulo": {
      "type": "string"
    },
    "NumTituloViaje": {
      "type": "string",
      "maxLength": 255
    },
    "Descripcion": {
      "type": "string"
    },
    "EstadoCliente": {
      "type": "string"
    },
    "FechaModificacionEstadoCliente": {
      "type": "string",
      "format": "date-time"
    },
    "Estacion": {
      "type": "string"
    },
    "OtraUbicacion": {
      "type": "string",
      "maxLength": 255
    },
    "Motivo": {
      "type": "string"
    },
    "FechaEpisodio": {
      "type": "string"
    },
    "Lugar": {
      "type": "string"
    },
    "Tren": {
      "type": "string"
    },
    "DirigidoA": {
      "type": "string"
    },
    "Colectivos": {
      "type": "string",
      "maxLength": 255
    },
    "NumIdentificacionPersonaTrabajad": {
      "type": "string",
      "maxLength": 255
    },
    "Clasificacion": {
      "type": "string"
    },
    "FechaYHoraConsulta": {
      "type": "string"
    },
    "DescripcionConsulta": {
      "type": "string"
    },
    "NBilleteTitulo": {
      "type": "string",
      "maxLength": 255
    },
    "ImporteAPagar": {
      "type": [
        "number",
        "string"
      ]
    },
    "Observaciones": {
      "type": "string"
    },
    "TipoDeInstalacion": {
      "type": "string"
    },
    "Localizacion": {
      "type": "string"
    },
    "FechaPerdida": {
      "type": "string"
    },
    "TipoObjeto": {
      "type": "string",
      "maxLength": 255
    },
    "NUnidadTren": {
      "type": "string",
      "maxLength": 255
    },
    "NCirculacion": {
      "type": "string",
      "maxLength": 255
    },
    "TipoRegistro": {
      "type": "string"
    },
    "Estado": {
      "type": "string"
    },
    "NombreCliente": {
      "type": "string",
      "maxLength": 255
    },
    "ApellidoCliente1": {
      "type": "string",
      "maxLength": 255
    },
    "ApellidoCliente2": {
      "type": "string",
      "maxLength": 255
    },
    "DNICliente": {
      "type": "string",
      "maxLength": 255
    },
    "EmailCliente": {
      "type": "string",
      "format": "email"
    },
    "TelefonoCliente1": {
      "type": "string",
      "maxLength": 255
    },
    "TelefonoCliente2": {
      "type": "string",
      "maxLength": 255
    },
    "NombreRep": {
      "type": "string",
      "maxLength": 255
    },
    "ApellidoRep1": {
      "type": "string",
      "maxLength": 255
    },
    "ApellidoRep2": {
      "type": "string",
      "maxLength": 255
    },
    "DNIRep": {
      "type": "string",
      "maxLength": 255
    },
    "EmailRep": {
      "type": "string",
      "format": "email"
    },
    "TelefonoRep1": {
      "type": "string",
      "maxLength": 255
    },
    "TelefonoRep2": {
      "type": "string",
      "maxLength": 255
    },
    "MetodoNotificacion": {
      "type": "string"
    },
    "Firma": {
      "type": "string",
      "description": "Firma de Tarjetas +Metro como data URL base64, por ejemplo data:image/png;base64,..."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipoFormulario": {
            "const": "reclamaciones"
          }
        },
        "required": [
          "tipoFormulario"
        ]
      },
      "then": {
        "required": [
          "Nombre",
          "Apellidos",
          "TipoDeDocumento",
          "NumeroDeDocumento",
          "CorreoElectronico",
          "Telefono",
          "Clasificacion",
          "FechaYHoraConsulta",
          "Lugar",
          "DescripcionConsulta"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipoFormulario": {
            "const": "consultas"
          }
        },
        "required": [
          "tipoFormulario"
        ]
      },
      "then": {
        "required": [
          "Nombre",
          "Apellidos",
          "TipoDeDocumento",
          "NumeroDeDocumento",
          "CorreoElectronico",
          "Telefono",
          "Descripcion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipoFormulario": {
            "const": "sugerencias"
          }
        },
        "required": [
          "tipoFormulario"
        ]
      },
      "then": {
        "required": [
          "Nombre",
          "Apellidos",
          "TipoDeDocumento",
          "NumeroDeDocumento",
          "CorreoElectronico",
          "Telefono",
          "Estacion",
          "Descripcion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipoFormulario": {
            "const": "agradecimientos"
          }
        },
        "required": [
          "tipoFormulario"
        ]
      },
      "then": {
        "required": [
          "Nombre",
          "Apellidos",
          "TipoDeDocumento",
          "NumeroDeDocumento",
          "CorreoElectronico",
          "Telefono",
          "Motivo",
          "Descripcion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipoFormulario": {
            "const": "objetos"
          }
        },
        "required": [
          "tipoFormulario"
        ]
      },
      "then": {
        "required": [
          "Nombre",
          "Apellidos",
          "TipoDeDocumento",
          "NumeroDeDocumento",
          "CorreoElectronico",
          "Telefono",
          "FechaPerdida",
          "Localizacion",
          "TipoObjeto",
          "Descripcion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipoFormulario": {
            "const": "tarjetas"
          }
        },
        "required": [
          "tipoFormulario"
        ]
      },
      "then": {
        "required": [
          "NombreCliente",
          "ApellidoCliente1",
          "DNICliente",
          "EmailCliente",
          "TelefonoCliente1",
          "MetodoNotificacion"
        ]
      }
    }
  ]
}
