{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metro-malaga.example/schemas/att-cliente-solicitud.schema.json",
  "title": "Metro Malaga - Solicitud de Atencion al Cliente",
  "description": "Contrato JSON real para POST /api/solicitudes/crear, alineado con FormularioPrototipo.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "tipoFormulario",
    "nombre",
    "apellidos",
    "tipoDocumento",
    "numeroDocumento",
    "email",
    "telefono",
    "consentimiento"
  ],
  "properties": {
    "tipoFormulario": {
      "type": "string",
      "enum": [
        "reclamaciones",
        "consultas",
        "sugerencias",
        "agradecimientos",
        "objetos",
        "tarjetas"
      ]
    },
    "nombre": { "type": "string", "minLength": 2, "maxLength": 80 },
    "apellidos": { "type": "string", "minLength": 2, "maxLength": 160 },
    "tipoDocumento": { "type": "string", "enum": ["NIF", "NIE", "PAS"] },
    "numeroDocumento": { "type": "string", "minLength": 3, "maxLength": 30 },
    "email": { "type": "string", "format": "email" },
    "confirmEmail": { "type": "string", "format": "email" },
    "telefono": {
      "type": "string",
      "pattern": "^(\\+34|0034|34)?[6789][0-9]{8}$"
    },
    "nacionalidad": { "type": "string", "maxLength": 8 },
    "consentimiento": { "type": "boolean", "const": true },
    "recibirPostal": { "type": ["boolean", "string"] },
    "viaContacto": { "type": "string", "maxLength": 200 },
    "numContacto": { "type": "string", "maxLength": 20 },
    "escContacto": { "type": "string", "maxLength": 20 },
    "pisoContacto": { "type": "string", "maxLength": 20 },
    "puerContacto": { "type": "string", "maxLength": 20 },
    "cpContacto": { "type": "string", "pattern": "^[0-9]{5}$" },
    "municipioContacto": { "type": "string", "maxLength": 120 },
    "provinciaContacto": { "type": "string", "maxLength": 80 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "tipoFormulario": { "const": "reclamaciones" } },
        "required": ["tipoFormulario"]
      },
      "then": {
        "required": [
          "clasificacion",
          "fechaIncidencia",
          "tipologia",
          "lugarIncidencia",
          "descripcionDetallada"
        ],
        "properties": {
          "clasificacion": { "type": "string", "enum": ["reclamacion", "queja"] },
          "fechaIncidencia": { "type": "string", "format": "date" },
          "horaIncidencia": { "type": "string" },
          "tipologia": { "type": "string" },
          "subtipologia": { "type": "string" },
          "lugarIncidencia": { "type": "string" },
          "trenIncidencia": { "type": "string" },
          "otroLugarIncidencia": { "type": "string" },
          "tipoInstalacion": { "type": "string" },
          "tipoTitulo": { "type": "string" },
          "descripcionDetallada": { "type": "string", "minLength": 20, "maxLength": 4000 }
        }
      }
    },
    {
      "if": {
        "properties": { "tipoFormulario": { "const": "consultas" } },
        "required": ["tipoFormulario"]
      },
      "then": {
        "required": ["descripcionCortaConsulta", "descripcionDetalladaConsulta"],
        "properties": {
          "descripcionCortaConsulta": { "type": "string", "minLength": 3, "maxLength": 150 },
          "descripcionDetalladaConsulta": { "type": "string", "minLength": 10, "maxLength": 3000 },
          "tipologiaConsulta": { "type": "string" },
          "subtipologiaConsulta": { "type": "string" },
          "lugarConsulta": { "type": "string" },
          "trenConsulta": { "type": "string" },
          "otroLugarConsulta": { "type": "string" },
          "tipoInstalacionConsulta": { "type": "string" },
          "tipoTituloConsulta": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": { "tipoFormulario": { "const": "sugerencias" } },
        "required": ["tipoFormulario"]
      },
      "then": {
        "required": ["areaSugerencia", "tituloSugerencia", "descripcionSugerencia"],
        "properties": {
          "areaSugerencia": { "type": "string" },
          "estacionSugerencia": { "type": "string" },
          "tituloSugerencia": { "type": "string", "minLength": 3, "maxLength": 150 },
          "descripcionSugerencia": { "type": "string", "minLength": 10, "maxLength": 3000 }
        }
      }
    },
    {
      "if": {
        "properties": { "tipoFormulario": { "const": "agradecimientos" } },
        "required": ["tipoFormulario"]
      },
      "then": {
        "required": ["motivoAgradecimiento", "descripcionAgradecimiento"],
        "properties": {
          "motivoAgradecimiento": { "type": "string" },
          "fechaAgradecimiento": { "type": "string", "format": "date" },
          "estacionAgradecimiento": { "type": "string" },
          "nombreEmpleado": { "type": "string" },
          "descripcionAgradecimiento": { "type": "string", "minLength": 10, "maxLength": 3000 }
        }
      }
    },
    {
      "if": {
        "properties": { "tipoFormulario": { "const": "objetos" } },
        "required": ["tipoFormulario"]
      },
      "then": {
        "required": [
          "fechaPerdida",
          "lineaMetroObjetos",
          "dondePerdidoObjetos",
          "nombreObjetoObjetos",
          "descripcionObjeto"
        ],
        "properties": {
          "tipoTituloObjetos": { "type": "string" },
          "fechaPerdida": { "type": "string", "format": "date" },
          "horaPerdida": { "type": "string" },
          "lineaMetroObjetos": { "type": "string", "enum": ["1", "2"] },
          "dondePerdidoObjetos": { "type": "string", "enum": ["estacion", "tren"] },
          "estacionPerdidaObjetos": { "type": "string" },
          "numeroTrenObjetos": { "type": "string" },
          "estacionOrigenObjetos": { "type": "string" },
          "estacionDestinoObjetos": { "type": "string" },
          "nombreObjetoObjetos": { "type": "string", "minLength": 2, "maxLength": 120 },
          "colorObjetoObjetos": { "type": "string" },
          "distintivoObjetoObjetos": { "type": "string" },
          "descripcionObjeto": { "type": "string", "minLength": 10, "maxLength": 3000 }
        }
      }
    },
    {
      "if": {
        "properties": { "tipoFormulario": { "const": "tarjetas" } },
        "required": ["tipoFormulario"]
      },
      "then": {
        "required": [
          "motivoTarjeta",
          "tipoTarjeta",
          "fechaNacimiento",
          "direccionCompleta",
          "codigoPostal",
          "municipio",
          "provincia",
          "puntoRecogida"
        ],
        "properties": {
          "motivoTarjeta": { "type": "string" },
          "tipoTarjeta": { "type": "string" },
          "fechaNacimiento": { "type": "string", "format": "date" },
          "genero": { "type": "string" },
          "direccionCompleta": { "type": "string", "minLength": 5, "maxLength": 250 },
          "codigoPostal": { "type": "string", "pattern": "^[0-9]{5}$" },
          "municipio": { "type": "string", "minLength": 2, "maxLength": 120 },
          "provincia": { "type": "string" },
          "puntoRecogida": { "type": "string" }
        }
      }
    }
  ]
}
